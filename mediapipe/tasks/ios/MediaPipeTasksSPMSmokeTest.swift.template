import XCTest
import MediaPipeTasksCommon
import MediaPipeTasksVision
import MediaPipeTasksText
import MediaPipeTasksAudio
import MediaPipeTasksRetrieval

final class MediaPipeTasksSPMSmokeTest: XCTestCase {

  func testRuntimeRegistrationAndInitialization() throws {
    // Verify C++ calculator registration and Swift/Obj-C API bindings across
    // Vision, Text, and Audio tasks by asserting task graph initialization
    // throws expected file errors rather than missing header/symbol/calculator
    // registration errors.
    verifyVisionRegistration()
    verifyTextRegistration()
    verifyAudioRegistration()
    verifyRetrievalRegistration()
  }

  private func verifyTaskInit<T>(
      name: String,
      domain: String,
      _ block: () throws -> T
  ) {
    do {
      _ = try block()
      XCTFail("\(domain) - \(name): Expected asset error, but init succeeded.")
    } catch {
      assertRegistrationError(error, domain: "\(domain) - \(name)")
    }
  }

  private func verifyVisionRegistration() {
    let dummyPath = "/nonexistent/vision.task"

    verifyTaskInit(name: "ImageClassifier", domain: "Vision") {
      let options = ImageClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageClassifier(options: options)
    }

    verifyTaskInit(name: "ImageEmbedder", domain: "Vision") {
      let options = ImageEmbedderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageEmbedder(options: options)
    }

    verifyTaskInit(name: "ObjectDetector", domain: "Vision") {
      let options = ObjectDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ObjectDetector(options: options)
    }

    verifyTaskInit(name: "FaceDetector", domain: "Vision") {
      let options = FaceDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try FaceDetector(options: options)
    }

    verifyTaskInit(name: "FaceLandmarker", domain: "Vision") {
      let options = FaceLandmarkerOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try FaceLandmarker(options: options)
    }

    verifyTaskInit(name: "HandLandmarker", domain: "Vision") {
      let options = HandLandmarkerOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try HandLandmarker(options: options)
    }

    verifyTaskInit(name: "GestureRecognizer", domain: "Vision") {
      let options = GestureRecognizerOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try GestureRecognizer(options: options)
    }

    verifyTaskInit(name: "PoseLandmarker", domain: "Vision") {
      let options = PoseLandmarkerOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try PoseLandmarker(options: options)
    }

    verifyTaskInit(name: "ImageSegmenter", domain: "Vision") {
      let options = ImageSegmenterOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageSegmenter(options: options)
    }

    verifyTaskInit(name: "InteractiveSegmenter", domain: "Vision") {
      let options = InteractiveSegmenterOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try InteractiveSegmenter(options: options)
    }
  }

  private func verifyTextRegistration() {
    let dummyPath = "/nonexistent/text.task"

    verifyTaskInit(name: "TextClassifier", domain: "Text") {
      let options = TextClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextClassifier(options: options)
    }

    verifyTaskInit(name: "TextEmbedder", domain: "Text") {
      let options = TextEmbedderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextEmbedder(options: options)
    }

    verifyTaskInit(name: "LanguageDetector", domain: "Text") {
      let options = LanguageDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try LanguageDetector(options: options)
    }
  }

  private func verifyAudioRegistration() {
    let dummyPath = "/nonexistent/audio.task"

    verifyTaskInit(name: "AudioClassifier", domain: "Audio") {
      let options = AudioClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try AudioClassifier(options: options)
    }
  }

  private func verifyRetrievalRegistration() {
    let dummyPath = "/nonexistent/embedder.task"

    // The universal embedder loads a LiteRT-LM model, so it follows the same
    // asset-error contract as the graph-backed tasks above.
    verifyTaskInit(name: "UniversalEmbedder", domain: "Retrieval") {
      let options = UniversalEmbedderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try UniversalEmbedder(options: options)
    }

    // The chunker and the vector store do not load a model, so they are
    // exercised directly to prove their symbols are linked in.
    do {
      let chunker = try DefaultTextChunker(
          chunkSize: 16, chunkOverlap: 4, wordThreshold: 0, mode: .character)
      let chunks = try chunker.chunkText(
          "MediaPipe Tasks retrieval smoke test input string.")
      XCTAssertFalse(
          chunks.isEmpty, "Retrieval - DefaultTextChunker: expected chunks.")
    } catch {
      XCTFail("Retrieval - DefaultTextChunker: unexpected error \(error)")
    }

    let dbPath = NSTemporaryDirectory()
        .appending("mediapipe_spm_smoke_test_vector_store.db")
    let store = SqliteVectorStore(
        databasePath: dbPath,
        embeddingDimension: 8)
    XCTAssertEqual(store.databasePath, dbPath)
    try? FileManager.default.removeItem(atPath: dbPath)
  }

  private func assertRegistrationError(_ error: Error, domain: String) {
    let nsError = error as NSError
    XCTAssertEqual(
        nsError.domain,
        "com.google.mediapipe.tasks",
        "\(domain): Expected domain com.google.mediapipe.tasks, got"
            + " \(nsError.domain)"
    )
    // Code 3 (InvalidArgumentError) or 5 (NotFoundError) proves C++ calculators
    // registered and graph init successfully reached model asset loading.
    // Stripped calculators fail with Code 2 (Unknown) or 9
    // (FailedPrecondition).
    let isExpectedAssetCode = nsError.code == 3 || nsError.code == 5
    XCTAssertTrue(
        isExpectedAssetCode,
        "\(domain): Expected asset error code 3/5, got \(nsError.code)"
    )
  }
}
