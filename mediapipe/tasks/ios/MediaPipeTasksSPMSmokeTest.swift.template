import XCTest
import MediaPipeTasksCommon
import MediaPipeTasksVision
import MediaPipeTasksText
import MediaPipeTasksAudio
import MediaPipeTasksRetrieval
import MediaPipeTasksDecision

final class MediaPipeTasksSPMSmokeTest: XCTestCase {

  func testRuntimeRegistrationAndInitialization() throws {
    // Verify C++ calculator registration, shared type identity across all
    // modules, and Swift API bindings by asserting task initialization throws
    // expected file errors rather than missing symbol/calculator registration
    // errors.
    try verifySharedTypesUnambiguous()
    verifyVisionRegistration()
    verifyTextRegistration()
    verifyAudioRegistration()
    verifyRetrievalRegistration()
    verifyDecisionRegistration()
  }

  private func verifySharedTypesUnambiguous() throws {
    let baseOptions = BaseOptions(modelAssetPath: "/nonexistent/smoke.task", delegate: .cpu)
    XCTAssertEqual(baseOptions.delegate, .cpu)

    let error = TasksError.invalidArgument("smoke")
    XCTAssertEqual(error.code, .invalidArgument)

    let floatBuffer = FloatBuffer(elements: [0.0, 1.0])
    XCTAssertEqual(floatBuffer.length, 2)

    let image = try MPImage(rgbaData: [255, 0, 0, 255], width: 1, height: 1)
    XCTAssertEqual(image.width, 1)
    XCTAssertEqual(image.height, 1)
  }

  private func verifyTaskInit<T>(
      name: String,
      domain: String,
      isGraphBacked: Bool = true,
      _ block: () throws -> T
  ) {
    do {
      _ = try block()
      XCTFail("\(domain) - \(name): Expected asset error, but init succeeded.")
    } catch {
      assertRegistrationError(
          error, domain: "\(domain) - \(name)", isGraphBacked: isGraphBacked)
    }
  }

  private func verifyVisionRegistration() {
    let dummyPath = "/nonexistent/vision.task"

    verifyTaskInit(name: "ImageClassifier", domain: "Vision") {
      var options = ImageClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageClassifier(options: options)
    }

    verifyTaskInit(name: "ImageEmbedder", domain: "Vision") {
      var options = ImageEmbedderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageEmbedder(options: options)
    }

    verifyTaskInit(name: "ObjectDetector", domain: "Vision") {
      var options = ObjectDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ObjectDetector(options: options)
    }

    verifyTaskInit(name: "FaceDetector", domain: "Vision") {
      var options = FaceDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try FaceDetector(options: options)
    }

    verifyTaskInit(name: "ImageSegmenter", domain: "Vision") {
      var options = ImageSegmenterOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try ImageSegmenter(options: options)
    }

    verifyTaskInit(name: "InteractiveSegmenter", domain: "Vision") {
      var options = InteractiveSegmenterOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try InteractiveSegmenter(options: options)
    }

    verifyTaskInit(name: "InteractiveSegmenterLegacy", domain: "Vision") {
      var options = InteractiveSegmenterLegacyOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try InteractiveSegmenterLegacy(options: options)
    }
  }

  private func verifyTextRegistration() {
    let dummyPath = "/nonexistent/text.task"

    verifyTaskInit(name: "TextClassifier", domain: "Text") {
      var options = TextClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextClassifier(options: options)
    }

    verifyTaskInit(name: "TextEmbedder", domain: "Text") {
      var options = TextEmbedderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextEmbedder(options: options)
    }

    verifyTaskInit(name: "LanguageDetector", domain: "Text") {
      var options = LanguageDetectorOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try LanguageDetector(options: options)
    }

    verifyTaskInit(name: "TextProofreader", domain: "Text", isGraphBacked: false) {
      var options = TextProofreaderOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextProofreader(options: options)
    }

    verifyTaskInit(name: "TextSummarizer", domain: "Text", isGraphBacked: false) {
      var options = TextSummarizerOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try TextSummarizer(options: options)
    }
  }

  private func verifyAudioRegistration() {
    let dummyPath = "/nonexistent/audio.task"

    verifyTaskInit(name: "AudioClassifier", domain: "Audio") {
      var options = AudioClassifierOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try AudioClassifier(options: options)
    }

    verifyTaskInit(name: "AudioTranscriber", domain: "Audio", isGraphBacked: false) {
      var options = AudioTranscriberOptions()
      options.baseOptions.modelAssetPath = dummyPath
      return try AudioTranscriber(options: options)
    }

    // TextToSpeech is a Swift API in MediaPipeTasksAudio backed by the C API.
    // Creating it with a nonexistent model proves the Swift module and C
    // symbols (MpTextToSpeechCreate) are linked in.
    do {
      let ttsOptions = TextToSpeechOptions(
          baseOptions: TTSBaseOptions(modelAssetPath: dummyPath))
      _ = try TextToSpeech(options: ttsOptions)
      XCTFail("Audio - TextToSpeech: Expected asset error, but init succeeded.")
    } catch let error as MediaPipeTTSError {
      guard case .status(let code, _) = error else {
        XCTFail("Audio - TextToSpeech: unexpected error \(error)")
        return
      }
      XCTAssertNotEqual(code, 0, "Audio - TextToSpeech: expected non-zero error code.")
    } catch {
      XCTFail("Audio - TextToSpeech: unexpected error \(error)")
    }
  }

  private func verifyRetrievalRegistration() {}

  private func verifyDecisionRegistration() {
    // The Decision Maker is a Swift-only module backed by the C API in
    // MediaPipeTasksCommon. Creating it with a nonexistent model proves the
    // Swift module and the C symbols (MpDecisionMakerCreate) are linked in:
    // the call must reach the engine and fail with an engine initialization
    // error, not a missing symbol / module error.
    do {
      _ = try DecisionMaker(modelPath: "/nonexistent/decision.task")
      XCTFail("Decision - DecisionMaker: Expected asset error, but init succeeded.")
    } catch let error as DecisionMakerError {
      guard case .failedToInitializeEngine = error else {
        XCTFail("Decision - DecisionMaker: unexpected error \(error)")
        return
      }
    } catch {
      XCTFail("Decision - DecisionMaker: unexpected error \(error)")
    }
  }

  private func assertRegistrationError(
      _ error: Error, domain: String, isGraphBacked: Bool
  ) {
    let nsError = error as NSError
    XCTAssertEqual(
        nsError.domain,
        "com.google.mediapipe.tasks",
        "\(domain): Expected domain com.google.mediapipe.tasks, got"
            + " \(nsError.domain)"
    )
    XCTAssertFalse(
        nsError.localizedDescription.contains("No registered object with name"),
        "\(domain) subgraph not linked: \(nsError.localizedDescription)"
    )
    // LiteRT-LM engine-backed tasks report engine-specific codes and messages.
    guard isGraphBacked else { return }
    // Code 3 (InvalidArgumentError) or 5 (NotFoundError) proves C++ calculators
    // registered and graph init successfully reached model asset loading.
    // Stripped calculators fail with Code 2 (Unknown) or 9
    // (FailedPrecondition).
    let isExpectedAssetCode = nsError.code == 3 || nsError.code == 5
    XCTAssertTrue(
        isExpectedAssetCode,
        "\(domain): Expected asset error code 3/5, got \(nsError.code)"
    )
    XCTAssertTrue(
        nsError.localizedDescription.contains("Unable to open file")
            || nsError.localizedDescription.contains("Model asset path does not exist"),
        "\(domain): Unexpected error description: \(nsError.localizedDescription)"
    )
  }
}
