import {WasmFileset} from './wasm_fileset';

/** The categories of tasks supported by MediaPipe. */
type MediaPipeTaskCategory =
    'audio'|'decision'|'genai'|'retrieval'|'text'|'litertlm_text'|'vision';

function createFileset(
    taskName: MediaPipeTaskCategory,
    basePath: string,
    useModule: boolean): Promise<WasmFileset> {
  const moduleSuffix = useModule ? '_module' : '';
  const suffix = `wasm${moduleSuffix}_internal`;

  return Promise.resolve({
    wasmLoaderPath: `${basePath}/${taskName}_${suffix}.js`,
    wasmBinaryPath: `${basePath}/${taskName}_${suffix}.wasm`,
  } as unknown as WasmFileset);
}

// tslint:disable:class-as-namespace

/**
 * Resolves the files required for the MediaPipe Task APIs.
 *
 * The returned filesets require that the Wasm files are published without
 * renaming. If this is not possible, you can invoke the MediaPipe Tasks APIs
 * using a manually created `WasmFileset`.
 */
export class FilesetResolver {
  /**
   * Creates a fileset for the MediaPipe Audio tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe Audio
   *    tasks.
   */
  static forAudioTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('audio', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe Decision tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe Decision
   *    tasks.
   */
  static forDecisionTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('decision', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe GenAI tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe GenAI
   *    tasks.
   */
  static forGenAiTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('genai', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe Retrieval tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe Retrieval
   *    tasks.
   */
  static forRetrievalTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('retrieval', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe Text tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe Text
   *    tasks.
   */
  static forTextTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('text', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe LiteRT LM Text tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe LiteRT LM
   *    Text tasks.
   */
  static forLiteRtLmTextTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset(
        'litertlm_text', basePath ?? ``, useModule);
  }

  /**
   * Creates a fileset for the MediaPipe Vision tasks.
   *
   * @export
   * @param basePath An optional base path to specify the directory the Wasm
   *    files should be loaded from. If not specified, the Wasm files are
   *    loaded from the host's root directory.
   * @param useModule Whether to use ES6 Modules for the Wasm files.
   * @return A `WasmFileset` that can be used to initialize MediaPipe Vision
   *    tasks.
   */
  static forVisionTasks(
      basePath?: string,
      useModule = false): Promise<WasmFileset> {
    return createFileset('vision', basePath ?? `` , useModule);
  }
}


